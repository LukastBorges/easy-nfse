{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "python",
      "package-name": "easy-nfse",
      "include-v-in-tag": true,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "draft": true,
      "force-tag-creation": true,
      "extra-files": [
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='easy-nfse')].version"
        }
      ],
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Funcionalidades"
        },
        {
          "type": "fix",
          "section": "Correções"
        },
        {
          "type": "perf",
          "section": "Desempenho"
        },
        {
          "type": "revert",
          "section": "Reversões"
        },
        {
          "type": "docs",
          "section": "Documentação",
          "hidden": false
        },
        {
          "type": "build",
          "section": "Build e dependências",
          "hidden": false
        },
        {
          "type": "refactor",
          "section": "Refatoração",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Testes",
          "hidden": true
        },
        {
          "type": "ci",
          "section": "CI",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Manutenção",
          "hidden": true
        },
        {
          "type": "style",
          "section": "Estilo",
          "hidden": true
        }
      ]
    }
  }
}
